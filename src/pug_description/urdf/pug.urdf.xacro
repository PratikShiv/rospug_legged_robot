<?xml version="1.0"?>

<robot xmlns:xacro="http://ros.org/wiki/xacro" name="rospug">
    <xacro:arg name="hardware" default="mock" />
    <xacro:arg name="servo_config" default="" />
    <xacro:property name="hardware" value="$(arg hardware)" />

    <link name="base_link">
        <visual>
            <geometry>
                <box size="0.25 0.12 0.06" />
            </geometry>
        </visual>
    </link>

    <!-- Placeholder leg: HAA (Hip ab/ad), HFE (hip flexion), KFE (knee). -->
    <xacro:macro name="leg" params="prefix x y">
        <link name="${prefix}_hip"/>
        
        <link name="${prefix}_thigh">
            <visual>
                <origin xyz="0 0 -0.035"/>
                <geometry>
                    <cylinder radius="0.008" length="0.07"/>
                </geometry>
            </visual>
        </link>
        
        <link name="${prefix}_shank">
            <visual>
                <origin xyz="0 0 -0.035"/>
                <geometry>
                    <cylinder radius="0.006" length="0.07"/>
                </geometry>
            </visual>
        </link>

        <link name="${prefix}_foot"/>

        <joint name="${prefix}_HAA" type="revolute">
            <parent link="base_link"/>
            <child link="${prefix}_hip"/>
            <origin xyz="${x} ${y} 0"/>
            <axis xyz="1 0 0"/>
            <limit lower="-0.5" upper="0.5" effort="3.0" velocity="6.0"/>            
        </joint>

        <joint name="${prefix}_HFE" type="revolute">
            <parent link="${prefix}_hip"/>
            <child link="${prefix}_thigh"/>
            <axis xyz="0 1 0"/>
            <limit lower="-1.2" upper="1.2" effort="3.0" velocity="6.0"/>            
        </joint>

        <joint name="${prefix}_KFE" type="revolute">
            <parent link="${prefix}_thigh"/>
            <child link="${prefix}_shank"/>
            <origin xyz="0.0 0.0 -0.7"/>
            <axis xyz="0 1 0"/>
            <limit lower="-2.4" upper="2.4" effort="3.0" velocity="6.0"/>            
        </joint>

        <joint name="${prefix}_foot_fixed" type="fixed">
            <parent link="${prefix}_shank"/>
            <child link="${prefix}_foot"/>
            <origin xyz="0.0 0.0 -0.7"/>         
        </joint>

    </xacro:macro>

    <xacro:leg prefix="LF" x="0.10" y="0.05"/>
    <xacro:leg prefix="RF" x="0.10" y="-0.05"/>
    <xacro:leg prefix="LH" x="-0.10" y="0.05"/>
    <xacro:leg prefix="RH" x="-0.10" y="-0.05"/>

    <xacro:include filename="$(find pug_description)/urdf/pug.ros2_control.xacro"/>
</robot>